# ========================================
# SHIPROCKET CHECKOUT - COMPLETE SETUP
# ========================================

# PUBLIC API KEY (visible to frontend - safe to expose)
# Get from: Shiprocket Settings → Integrations → API Key
NEXT_PUBLIC_SHIPROCKET_API_KEY=your_api_key_here

# SECRET KEY (KEEP PRIVATE - Never expose to frontend!)
# Get from: Shiprocket Settings → Secret Key
SHIPROCKET_SECRET_KEY=your_secret_key_here

# SELLER ID (public - your unique identifier at Shiprocket)
# Get from: Shiprocket Settings → Seller ID
NEXT_PUBLIC_SHIPROCKET_SELLER_ID=your_seller_id_here

# BASE URL (Shiprocket API endpoint)
NEXT_PUBLIC_SHIPROCKET_BASE_URL=https://checkout-api.shiprocket.com

# ========================================
# SHIPROCKET REST API CREDENTIALS
# ========================================

# Email for Shiprocket account (used for order creation via REST API)
SHIPROCKET_EMAIL=your_email@example.com

# Password for Shiprocket account (used for order creation via REST API)
SHIPROCKET_PASSWORD=your_shiprocket_password
